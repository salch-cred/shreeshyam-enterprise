# Copy to .env locally. On Vercel: Project → Settings → Environment Variables. Never commit .env.
DATABASE_URL=postgresql://user:pass@db.supabase.co:6543/sse?pgbouncer=true
# Free options (pick one): Supabase free 500MB · Neon free 3GB · same string shape
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# At least 10 characters. The API refuses to start otherwise. Use the same value as the site project.
ADMIN_PASSWORD=
CORS_ORIGIN=https://shreeshyamhardware.site
PORT=4000
UPI_ID=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox with test keys, production with live keys
CASHFREE_ENV=sandbox
# This API's public https address. Cashfree posts payment confirmations to it.
PUBLIC_API_URL=
# SMS sign-in. Needs a DLT approved template that contains ##otp##.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Most codes sent per day, so a bot cannot drain the SMS balance.
OTP_DAILY_CAP=300
# Text the owner on every paid order. Second DLT template with ##invoice## and ##amount##.
MSG91_OWNER_TEMPLATE_ID=
OWNER_PHONE=
