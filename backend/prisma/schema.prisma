// Prisma schema — source of truth for the free Postgres DB.
// Runtime uses node-postgres directly (smaller Vercel cold start); `npm run db:push` applies this.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id
  name          String
  brand         String   @default("-")
  category      String   @default("General")
  unit          String   @default("pcs")
  hsn           String   @default("")
  image         String   @default("")
  rateRetail    Float    @map("rate_retail")
  rateWholesale Float    @map("rate_wholesale")
  gstPct        Int      @default(18) @map("gst_pct")
  stock         Int      @default(0)
  minStock      Int      @default(5) @map("min_stock")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([name])
  @@map("products")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @default("")
  passwordHash String   @default("") @map("password_hash")
  gstin        String   @default("")
  address      String   @default("")
  role         String   @default("customer")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Invoice {
  no       String   @id
  date     DateTime @default(now())
  type     String   @default("TAX") // TAX | EST
  customer String   @default("")
  phone    String   @default("")
  gstin    String   @default("")
  address  String   @default("")
  orderId  String   @default("") @map("order_id")
  mode     String   @default("")
  items    Json
  subtotal Int      @default(0)
  discount Float    @default(0)
  gst      Int      @default(0)
  grand    Int      @default(0)
  paid     Float    @default(0)
  balance  Float    @default(0)

  @@index([date])
  @@index([orderId])
  @@map("invoices")
}

model Order {
  id      String   @id
  source  String   @default("web")
  text    String   @default("")
  status  String   @default("new")
  phone   String   @default("")
  email   String   @default("")
  invoiceNo String @default("") @map("invoice_no")
  paidAt  DateTime? @map("paid_at")
  created DateTime @default(now())

  @@index([status])
  @@index([email])
  @@map("orders")
}

model LoginLog {
  id    Int      @id @default(autoincrement())
  email String
  at    DateTime @default(now())

  @@index([email, at])
  @@map("login_log")
}

model OtpCode {
  id       String   @id
  email    String
  ip       String
  codeHash String   @map("code_hash")
  attempts Int      @default(0)
  used     Boolean  @default(false)
  created  DateTime @default(now())
  expires  DateTime

  @@index([email, created])
  @@map("otp_codes")
}

model StockLog {
  id     Int      @id @default(autoincrement())
  pid    String   @map("product_id")
  delta  Int
  reason String   @default("")
  date   DateTime @default(now())

  @@index([pid])
  @@map("stock_log")
}

model Content {
  key   String @id
  value Json

  @@map("content")
}
