{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; script-src 'self' https://sdk.cashfree.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:; frame-src https://sdk.cashfree.com https://*.cashfree.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=31536000; includeSubDomains"
    },
    {
     "key": "Cross-Origin-Opener-Policy",
     "value": "same-origin-allow-popups"
    }
   ]
  },
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=300, stale-while-revalidate=86400"
    }
   ]
  },
  {
   "source": "/data/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=60, must-revalidate"
    }
   ]
  },
  {
   "source": "/(admin|billing)(.html)?",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  }
 ],
 "trailingSlash": false
}